  </ItemGroup>

  <ItemGroup>
    <Content Include="suite\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="suite" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Text" />
  </ItemGroup>

</Project>
